+    for (uint8_t attempt = 0; attempt < sensor_ready_retries; ++attempt) {
+      ready_result = i2c::IsDeviceReady(i2c_handle, uint16_t(sensor_address << 1), 1, sensor_i2c_timeout_ms);
+      if (ready_result == i2c::Result::ok) break;
+    }
+    return ready_result;
+  }
